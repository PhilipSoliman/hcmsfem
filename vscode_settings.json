{
    "settings": {
        "actionButtons": {
            "commands": [
                {
                    "name": "$(triangle-right) Run Python (show output)",
                    "color": "green",
                    "singleInstance": true,
                    "command": "${workspaceFolder}/.venv/Scripts/python.exe ${file} --show-output"
                },
                {
                    "name": "$(triangle-right) Run Python (generate output)",
                    "color": "green",
                    "singleInstance": true,
                    "command": "${workspaceFolder}/.venv/Scripts/python.exe ${file} --generate-output"
                }
            ],
            "defaultColor": "white",
            "reloadButton": "↻",
            "loadNpmCommands": false
        },
        "python.analysis.extraPaths": [
            "hcmsfem"
        ],
        "[python]": {
            "editor.wordWrap": "bounded",
            "editor.wordWrapColumn": 100
        },
        "[markdown]": {
            "editor.wordWrap": "bounded",
            "editor.wordWrapColumn": 150
        }
    },
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "Python Debugger: Current File",
                "type": "debugpy",
                "request": "launch",
                "program": "${file}",
                "console": "integratedTerminal",
                "env": {
                    "MY_LOG_LEVEL": "DEBUG",
                    "DISABLE_PROGRESS": "1"
                }
            }
        ]
    },
    "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "seunlanlege.action-buttons"
    ]
}